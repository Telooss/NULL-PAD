{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NULL-CONTROL",
  "mainBinaryName": "nullctl",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/nullctl-engine"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Telooss/NULL-PAD/releases/latest/download/latest.json"],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
